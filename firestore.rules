rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/data/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /shared/{doc} {
      allow get, write: if request.auth != null;
      allow list: if false;
    }
    /* Avis (note + message, bouton "Donner mon avis") : absent des règles
       jusqu'ici, donc bloqué pour tout le monde (Firestore refuse par défaut
       tout chemin non couvert par une règle) — vérifié en conditions réelles
       le 2026-11-13 : écriture en mode invité -> permission-denied.
       Le mode invité ne se connecte jamais, même anonymement, sur cette
       appli Firebase principale, donc la création doit rester possible sans
       authentification. On n'autorise que la création (jamais la lecture,
       la modification ou la suppression depuis le client), avec une forme
       de document strictement limitée à ce que l'app envoie réellement. */
    match /feedback/{doc} {
      allow create: if request.resource.data.keys().hasOnly(['rating', 'text', 'uid', 'email', 'createdAt'])
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
                    && request.resource.data.text is string
                    && request.resource.data.text.size() < 5000
                    && request.resource.data.createdAt is number;
      allow read, update, delete: if false;
    }
    /* Témoignages/avis mis en avant sur la page "À propos" (section
       "Ils en parlent"). Collection séparée de "feedback" : elle ne doit
       JAMAIS contenir d'email ni d'uid — seulement du contenu que vous avez
       vous-même choisi de rendre public. Remplissage manuel uniquement,
       depuis la console Firebase (Firestore Database > Données > créer la
       collection "public_testimonials" > ajouter un document avec les
       champs : text (string, obligatoire), rating (nombre 1-5, optionnel),
       name (string, optionnel — laissez vide pour "Anonyme"), createdAt
       (nombre, optionnel, ex. Date.now() au moment où vous l'ajoutez, sert
       à l'ordre d'affichage). Lecture publique (même sans connexion),
       écriture impossible depuis l'app (la console Firebase, elle,
       n'est pas soumise à ces règles). */
    match /public_testimonials/{doc} {
      allow read: if true;
      allow write: if false;
    }
    /* Compteur d'usage ("X personnes ont prié avec Lumen cette semaine"),
       affiché à l'accueil et en message de renforcement après une prière.
       Un seul document, créé automatiquement par le premier appareil qui
       écrit, puis mis à jour par transaction à chaque nouvel appareil/jour.
       Lecture et écriture ouvertes à toute session (même invité) tant
       qu'elle est passée par la connexion anonyme "contenu partagé" — pas
       de données personnelles ici, seulement des compteurs. Le total ne
       peut qu'augmenter d'exactement 1 par écriture, pour éviter qu'une
       requête bricolée depuis la console du navigateur ne gonfle le
       chiffre d'un coup. */
    match /stats/usage {
      allow get: if request.auth != null;
      allow list: if false;
      allow delete: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['total','today','todayDate','week','weekStart'])
        && request.resource.data.total == 1
        && request.resource.data.today == 1
        && request.resource.data.week == 1
        && request.resource.data.todayDate is string
        && request.resource.data.weekStart is string;
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(['total','today','todayDate','week','weekStart'])
        && request.resource.data.total is int
        && request.resource.data.today is int
        && request.resource.data.week is int
        && request.resource.data.todayDate is string
        && request.resource.data.weekStart is string
        && request.resource.data.total == resource.data.total + 1
        && request.resource.data.today >= 1 && request.resource.data.today <= request.resource.data.total
        && request.resource.data.week >= 1 && request.resource.data.week <= request.resource.data.total;
    }
  }
}
